//Q1. First unique character in a string
class Solution {
public:
    int firstUniqChar(string s) {
        int n = s.size();
        unordered_map<char,int> f;
        for(int i = 0;i < n; i++)
        {
            f[s[i]]++;
        }
        for(int i = 0;i < n; i++)
        {
            if(f[s[i]] == 1)
                return i;  
        }
        return -1;
    }
};
//Q2. Ransom Note
class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        int freq[26] = {0};

        // count letters in magazine
        for(char c : magazine) {
            freq[c - 'a']++;
        }
        // try to use letters for ransomNote
        for(char c : ransomNote) {
            if(freq[c - 'a'] == 0) {
                return false; // letter not available
            }
            freq[c - 'a']--;
        }
        return true;
    }
};
//Q3. max no. of balloon 
class Solution {
public:
    int maxNumberOfBalloons(string s) {
        int n = s.size();
        int res = INT_MAX;
       unordered_map<char,int>have;
       unordered_map<char,int>need;
       for(int i =0;i<n;i++)
       {
        have[s[i]]++;
       } 
       need['b'] = 1;
       need['a'] = 1;
       need['l'] = 2;
       need['o'] = 2;
       need['n'] = 1;
       for(auto i : need)
       {
        char c = i.first;
        int fneed = i.second;
        int fhave = have[c];
        int times = fhave / fneed;
        res = min(res,times);
       }
      return res;
    }
};
//Q4. Longest palindrome
class Solution {
public:
    int longestPalindrome(string s) {
        int n = s.size();
        unordered_map<char,int>f;
        for(int i = 0;i<n;i++){
            f[s[i]]++;
        }
            bool odd = false;
            int res = 0;
            for(auto i: f)
            {
                int val = i.second;
                if(val % 2 == 0)
                res = res + val;
                else
                odd = true;
            }
                if(odd == false)
                return res;
                 for(auto i: f)
               {
                int val = i.second;
                if(val % 2 == 1)
                res  += val - 1;
                }
        return res+1;
    }
};
