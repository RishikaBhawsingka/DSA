//Kth smallest
class Solution {
public:
    int kthSmallest(vector<int> &a, int k) {
        priority_queue<int> pq;

        for (int i = 0; i < k; i++) {
            pq.push(a[i]);
        }
//we are using max heap here
        for (int i = k; i < a.size(); i++) {
            if (a[i] < pq.top()) {
                pq.pop();
                pq.push(a[i]);
            }
        }

        return pq.top();
    }
};


//K closest pointer to origin
class Solution {
public:
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        priority_queue<pair<int , pair<int , int>>> pq;  //distance + point
        for(auto&p : points){
            int x = p[0];
            int y = p[1];

            int dist = x*x + y*y;

            pq.push({dist , {x,y}});

            if(pq.size() > k)
            {
                pq.pop();
            }
        }
        vector<vector<int>> ans;
        while(!pq.empty()){
            auto point = pq.top().second;
            ans.push_back({point.first , point.second});

            pq.pop();
        }
      return ans;
    }
};
