//Kth smallest
class Solution {
public:
    int kthSmallest(vector<int> &a, int k) {
        priority_queue<int> pq;

        for (int i = 0; i < k; i++) {
            pq.push(a[i]);
        }
//we are using max heap here
        for (int i = k; i < a.size(); i++) {
            if (a[i] < pq.top()) {
                pq.pop();
                pq.push(a[i]);
            }
        }

        return pq.top();
    }
};
