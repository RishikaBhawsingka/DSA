//Q1. find peak index in mountain array
class Solution {
public:
    int peakIndexInMountainArray(vector<int>& a) {
        int st = 1 , end = a.size() - 2;
        while(st <= end){
            int mid = st + (end-st)/2;

            if(a[mid - 1] < a[mid] && a[mid] > a[mid + 1]){
                return mid ;
            }
            else if(a[mid - 1] < a[mid]){
                st = mid + 1;
            }
            else{
                end = mid - 1;
            }

            
        }
    return 0;
    }
};
//Q2. Find min in sorted rotated array
class Solution {
public:
    int findMin(vector<int>& nums) {
        int n = nums.size(); 
        int low = 0, high = n - 1;
        while(low < high)
        {
            int mid = (low + high) / 2;
            // minimum is in right half
            if(nums[mid] > nums[high])
            {
                low = mid + 1;
            }
            else
            {
                // minimum can be mid itself
                high = mid;
            }
        }
        return nums[low];
    }
};
