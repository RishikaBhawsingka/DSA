//Q!.Remove all duplicates adjacent to it
class Solution {
public:
    string removeDuplicates(string s) {
        string result = "";
        
        for (char c : s) {
            if (!result.empty() && result.back() == c) {
                result.pop_back(); // remove duplicate
            } else {
                result.push_back(c); // add character
            }
        }
       return result;
    }
};
/Q2. Valid parenthesis
class Solution {
public:
    bool isValid(string s) {
        stack<char> st;

      for(char &ch : s)
     {
        if(ch == '(')
          st.push(')');
         else if(ch == '{')
           st.push('}');
           else if(ch == '[')
           st.push(']');
           else if(st.empty() || st.top() != ch)
           {
            return false;
           }
           else{
            st.pop();
           }
    }
      return st.empty();
    }
};
