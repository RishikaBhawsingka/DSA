//Q!.Remove all duplicates adjacent to it
class Solution {
public:
    string removeDuplicates(string s) {
        string result = "";
        
        for (char c : s) {
            if (!result.empty() && result.back() == c) {
                result.pop_back(); // remove duplicate
            } else {
                result.push_back(c); // add character
            }
        }
       return result;
    }
};
/Q2. Valid parenthesis
class Solution {
public:
    bool isValid(string s) {
        stack<char> st;

      for(char &ch : s)
     {
        if(ch == '(')
          st.push(')');
         else if(ch == '{')
           st.push('}');
           else if(ch == '[')
           st.push(']');
           else if(st.empty() || st.top() != ch)
           {
            return false;
           }
           else{
            st.pop();
           }
    }
      return st.empty();
    }
};
//Q3. next greater element 2
class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans(n, -1);
        stack<int> st; // stores indices
        for (int i = 2 * n - 1; i >= 0; i--) {
            while (!st.empty() && nums[st.top()] <= nums[i % n]) {
                st.pop();
            }
            if (i < n) {
                if (!st.empty()) {
                    ans[i] = nums[st.top()];
                }
            }
            st.push(i % n);
        }
        return ans;
    }
};
//Q4. Daily temp
class Solution {
public:
    vector<int> dailyTemperatures(vector<int>& temperatures) {
        int n = temperatures.size();
        vector<int> ans(n, 0);
        stack<int> st; // stores indices
        
        for(int i = 0; i < n; i++) {
            while(!st.empty() && temperatures[i] > temperatures[st.top()]) {
                int prev = st.top();
                st.pop();
                ans[prev] = i - prev;
            }
            st.push(i);
        }
        return ans;
    }
};
//Q5. remove duplicates in k   (lc-1209)
class Solution {
public:
    string removeDuplicates(string s, int k) {
        int n = s.size();
        string res = "";   // FIX 1: remove extra space
        stack<pair<char,int>> st;
        for(int i = 0;i<n;i++)
        {
            char c = s[i];

            if(st.empty()){
                st.push({c,1});
                continue;
            }
            if(st.top().first != s[i])
            {
                st.push({c,1});
                continue;
            }
            if(st.top().second < (k-1))
            {
                pair<char,int> p = st.top();
                st.pop();
                st.push({p.first,p.second+1});
                continue;
            }
            st.pop(); // remove k duplicates
        }
            //build result AFTER processing entire string
        while(!st.empty())
        {
            pair<char,int> p = st.top();
            st.pop();
            while(p.second--)
            {
                res.push_back(p.first);
            }
        }
        reverse(res.begin(), res.end()); // important
        return res;
    }
};

